# ---------------------------------------------------------------- 数据库
# 本地开发：docker compose up -d db 启动的数据库
DATABASE_URL="postgresql://nowx:nowx@localhost:5432/nowx?schema=public"

# ---------------------------------------------------------------- 应用
# 用于解释「今天」、截止日期和周期起止日期的时区
APP_TIMEZONE="Asia/Shanghai"
# 对外访问地址，用于生成发给新成员的登录信息
APP_URL="http://localhost:3000"
# 上传文件的存储目录（容器中挂载为持久卷）
STORAGE_DIR="./storage"

# ---------------------------------------------------------------- 初始管理员（仅 pnpm db:seed 使用）
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_NAME="管理员"

# ---------------------------------------------------------------- 项目助手（可选，不配置则助手不可用）
# 接口协议：anthropic（Claude API）或 openai（OpenAI 及兼容 Chat Completions 的服务）
ASSISTANT_PROTOCOL="anthropic"
ASSISTANT_API_KEY=""
# 模型：anthropic 协议默认 claude-opus-5-5；openai 协议必须填写
ASSISTANT_MODEL=""
# 接口地址：留空使用官方地址；经代理、网关或兼容服务访问时填写
ASSISTANT_BASE_URL=""
