# 生产部署配置：复制为 .env.production 后填写，使用
#   docker compose --env-file .env.production --profile prod up -d --build

# 访问域名（Caddy 据此申请 HTTPS 证书；内网 HTTP 部署填 :80）
DOMAIN="nowx.example.com"
# 对外访问地址（用于发给新成员的登录信息）
APP_URL="https://nowx.example.com"
APP_TIMEZONE="Asia/Shanghai"

# 数据库（请修改为强密码）
POSTGRES_USER="nowx"
POSTGRES_PASSWORD="please-change-me"
POSTGRES_DB="nowx"

# 初始管理员（首次部署后执行一次 pnpm db:seed，登录后会被要求修改密码）
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="please-change-me-too"
SEED_ADMIN_NAME="管理员"

# 项目助手（可选，不填则助手不可用）
# 接口协议：anthropic（Claude API）或 openai（OpenAI 及兼容 Chat Completions 的服务）
ASSISTANT_PROTOCOL="anthropic"
ASSISTANT_API_KEY=""
# 模型：anthropic 协议默认 claude-opus-5-5；openai 协议必须填写
ASSISTANT_MODEL=""
# 接口地址：留空使用官方地址；经代理、网关或兼容服务访问时填写
ASSISTANT_BASE_URL=""
