{
  "name": "nowx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "lint": "eslint",
    "typecheck": "cf workers types && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:types": "kysely-codegen --dialect postgres --out-file src/server/db/schema.ts --exclude-pattern _prisma_migrations",
    "db:seed": "prisma db seed",
    "db:demo": "tsx prisma/demo.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "deploy": "node workers/check-deploy.mjs && pnpm run build && node workers/publish.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/react-query": "^5.108.4",
    "argon2id": "1.0.1",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "hono": "^4.13.22",
    "kysely": "^0.29.9",
    "lucide-react": "^1.74.0",
    "next-themes": "^0.4.6",
    "openai": "^7.60.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.3",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.4",
    "@eslint/js": "^10.0.1",
    "@node-rs/argon2": "^2.2.2",
    "@playwright/test": "^1.65.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "cf": "1.0.0-rc.4",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.74.0",
    "vite": "8.3.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.32.1",
  "type": "module"
}
